# Intelligence provider
# kimi | amos-hosted | bedrock | ollama | llama-cpp | openai-compatible
AMOS_MODEL_PROVIDER=kimi
AMOS_MODEL=kimi-k3
# Required for amos-hosted and custom endpoints; optional override for every provider.
# AMOS_MODEL_BASE_URL=https://inference.example.com/v1
# AMOS_MODEL_API_KEY=
AMOS_MODEL_REASONING_EFFORT=max
AMOS_MODEL_MAX_COMPLETION_TOKENS=8192

# Kimi / Moonshot aliases remain supported.
MOONSHOT_API_KEY=sk-your-key
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=max
KIMI_MAX_COMPLETION_TOKENS=8192

# Amazon Bedrock example:
# AMOS_MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=...
# AMOS_MODEL=openai.gpt-oss-120b

# Local Ollama example:
# AMOS_MODEL_PROVIDER=ollama
# AMOS_MODEL=gpt-oss:20b

# AMOS MCP
AMOS_MCP_URL=https://app.amoslabs.com/mcp
# Humans should run `amos-agent login`. Optional for CI/unattended identities:
# AMOS_API_KEY=amos-your-scoped-key
# AMOS_AGENT_AUTH_MODE=api-key

# Local safety
AMOS_AGENT_WORKSPACE=.
AMOS_AGENT_AUTO_APPROVE_BASH=false
AMOS_AGENT_ALLOW_OUTSIDE_WORKSPACE=false
AMOS_AGENT_BASH_TIMEOUT_MS=60000
AMOS_AGENT_MAX_OUTPUT_BYTES=24000

# Optional native web search
BRAVE_SEARCH_API_KEY=
