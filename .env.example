# AMOS Desktop users normally configure intelligence in the application.
# This file is for CLI development, CI, and compatible-endpoint testing.

# Intelligence provider:
# amos-hosted | bedrock | openai-compatible | kimi | ollama | llama-cpp
AMOS_MODEL_PROVIDER=openai-compatible
AMOS_MODEL=your-model
AMOS_MODEL_BASE_URL=https://models.example.com/v1
AMOS_MODEL_API_KEY=
AMOS_MODEL_REASONING_EFFORT=max
AMOS_MODEL_MAX_COMPLETION_TOKENS=8192

# AMOS-hosted example:
# AMOS_MODEL_PROVIDER=amos-hosted
# AMOS_MODEL_BASE_URL=https://inference.example.com/v1
# AMOS_MODEL=your-managed-model
# No second long-lived provider key is required.

# Amazon Bedrock compatible-endpoint example:
# AMOS_MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=...
# AMOS_MODEL=your-bedrock-model

# Moonshot/Kimi provider example:
# AMOS_MODEL_PROVIDER=kimi
# MOONSHOT_API_KEY=...
# AMOS_MODEL=kimi-k3
#
# Legacy aliases remain supported:
# KIMI_MODEL=kimi-k3
# KIMI_REASONING_EFFORT=max
# KIMI_MAX_COMPLETION_TOKENS=8192

# Local Ollama example:
# AMOS_MODEL_PROVIDER=ollama
# AMOS_MODEL=your-local-model
# AMOS_MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Local llama.cpp example:
# AMOS_MODEL_PROVIDER=llama-cpp
# AMOS_MODEL=your-local-model
# AMOS_MODEL_BASE_URL=http://127.0.0.1:8080/v1

# AMOS managed platform
AMOS_MCP_URL=https://app.amoslabs.com/mcp

# Humans should run `amos-agent login`.
# CI and unattended identities may use a narrowly scoped agent key:
# AMOS_API_KEY=amos-your-scoped-key
# AMOS_AGENT_AUTH_MODE=api-key

# Local safety
AMOS_AGENT_WORKSPACE=.
AMOS_AGENT_AUTO_APPROVE_BASH=false
AMOS_AGENT_AUTO_APPROVE_WRITES=false
AMOS_AGENT_ALLOW_OUTSIDE_WORKSPACE=false
# Defaults to PowerShell on Windows and /bin/bash elsewhere.
# AMOS_AGENT_SHELL=/path/to/your/shell
AMOS_AGENT_BASH_TIMEOUT_MS=60000
AMOS_AGENT_MAX_OUTPUT_BYTES=24000

# Optional native web search
BRAVE_SEARCH_API_KEY=
