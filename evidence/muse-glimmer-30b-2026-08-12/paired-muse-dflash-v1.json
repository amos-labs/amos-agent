            "code": "function selectPortfolio(items, budget){\n    const n = items.length;\n    let bestValue = -1;\n    let bestSpend = Infinity;\n    let bestIds = null;\n    const idToItem = new Map();\n    for(const it of items) idToItem.set(it.id, it);\n    const totalMasks = 1 << n;\n    for(let mask = 0; mask < totalMasks; mask++){\n        let spend = 0;\n        let value = 0;\n        const chosen = [];\n        const groups = new Set();\n        let feasible = true;\n        for(let i = 0; i < n; i++){\n            if(mask & (1 << i)){\n                const it = items[i];\n                chosen.push(it);\n                spend += it.spend;\n                value += it.value;\n                if(it.group != null && it.group !== undefined){\n                    if(groups.has(it.group)){ feasible = false; break; }\n                    groups.add(it.group);\n                }\n            }\n        }\n        if(!feasible || spend > budget) continue;\n        const chosenIds = new Set(chosen.map(it=>it.id));\n        for(const it of chosen){\n            const req = it.requires;\n            if(!req) continue;\n            if(Array.isArray(req)){\n                for(const r of req){\n                    if(!chosenIds.has(r)){ feasible = false; break; }\n                }\n            }else if(typeof req === 'string'){\n                if(!chosenIds.has(req)){ feasible = false; break; }\n            }\n            if(!feasible) break;\n        }\n        if(!feasible) continue;\n        const idsSorted = chosen.map(it=>it.id).sort();\n        if(value > bestValue || (value === bestValue && spend < bestSpend) || (value === bestValue && spend === bestSpend && bestIds && idsSorted.join(',') < bestIds.join(','))){\n            bestValue = value;\n            bestSpend = spend;\n            bestIds = idsSorted;\n        }else if(value === bestValue && spend === bestSpend && bestIds === null){\n            bestIds = idsSorted;\n        }\n    }\n    return bestI