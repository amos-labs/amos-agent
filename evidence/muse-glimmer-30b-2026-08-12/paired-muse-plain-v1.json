            "code": "function selectPortfolio(items, budget){\n  const n = items.length;\n  const idToIdx = new Map();\n  items.forEach((it,i)=>idToIdx.set(it.id,i));\n  let best = {value:-1, spend:Infinity, ids:[]};\n  const totalMasks = 1<<n;\n  for(let mask=0; mask<totalMasks; mask++){\n    let spend=0, value=0;\n    const chosenIdx=[];\n    const groups=new Set();\n    let feasible=true;\n    for(let i=0;i<n;i++){\n      if(mask>>i &1){\n        const it=items[i];\n        spend+=it.spend;\n        if(spend>budget){ feasible=false; break; }\n        value+=it.value;\n        chosenIdx.push(i);\n        if(it.group!=null){\n          if(groups.has(it.group)){ feasible=false; break; }\n          groups.add(it.group);\n        }\n      }\n    }\n    if(!feasible) continue;\n    // requires closure\n    const chosenSet=new Set(chosenIdx);\n    for(const i of chosenIdx){\n      const req=items[i].requires||[];\n      for(const rId of req){\n        const rIdx=idToIdx.get(rId);\n        if(rIdx===undefined || !chosenSet.has(rIdx)){ feasible=false; break; }\n      }\n      if(!feasible) break;\n    }\n    if(!feasible) continue;\n    const ids=chosenIdx.map(i=>items[i].id).sort();\n    const cmpValue=value-best.value;\n    const cmpSpend=spend-best.spend;\n    const lex = JSON.stringify(ids) < JSON.stringify(best.ids) ? -1 : 1;\n    if(cmpValue>0 || (cmpValue===0 && cmpSpend<0) || (cmpValue===0 && cmpSpend===0 && ids.length && (best.ids.length===0 || JSON.stringify(ids)<JSON.stringify(best.ids)))){\n      // tie handling for empty best\n      if(best.value===-1 || value>best.value || (value===best.value && spend<best.spend) || (value===best.value && spend===best.spend && JSON.stringify(ids)<JSON.stringify(best.ids))){\n        best={value, spend, ids};\n      }\n    }\n    if(best.value===-1){\n      best={value, spend, ids};\n    }\n  }\n  return best.ids;\n}"
