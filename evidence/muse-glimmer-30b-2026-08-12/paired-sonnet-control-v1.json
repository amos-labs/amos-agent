            "code": "function reconcileBalances(events, initial) {\n  const result = {};\n  for (const accountId in initial) {\n    result[accountId] = {\n      balance: initial[accountId].balance,\n      version: initial[accountId].version\n    };\n  }\n\n  // Deduplicate events by eventId\n  const seenEventIds = new Map();\n  for (const evt of events) {\n    if (!seenEventIds.has(evt.eventId)) {\n      seenEventIds.set(evt.eventId, evt);\n    }\n  }\n  const uniqueEvents = Array.from(seenEventIds.values());\n\n  // Group unique events by accountId, then by version\n  const byAccount = new Map();\n  for (const evt of uniqueEvents) {\n    if (!byAccount.has(evt.accountId)) {\n      byAccount.set(evt.accountId, new Map());\n    }\n    const versionMap = byAccount.get(evt.accountId);\n    if (!versionMap.has(evt.version)) {\n      versionMap.set(evt.version, []);\n    }\n    versionMap.get(evt.version).push(evt);\n  }\n\n  for (const [accountId, versionMap] of byAccount.entries()) {\n    if (!result[accountId]) {\n      continue;\n    }\n\n    let current = result[accountId];\n    let currentBalance = current.balance;\n    let currentVersion = current.version;\n\n    while (true) {\n      const nextVersion = currentVersion + 1;\n      const candidates = versionMap.get(nextVersion);\n\n      if (!candidates || candidates.length === 0) {\n        break;\n      }\n\n      if (candidates.length > 1) {\n        break;\n      }\n\n      const evt = candidates[0];\n      currentBalance += evt.delta;\n      currentVersion = nextVersion;\n    }\n\n    result[accountId] = {\n      balance: currentBalance,\n      version: currentVersion\n    };\n  }\n\n  return result;\n}"
