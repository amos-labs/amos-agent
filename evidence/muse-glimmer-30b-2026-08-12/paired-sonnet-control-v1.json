            "code": "function selectPortfolio(items, budget) {\n  const n = items.length;\n  const idSet = new Set(items.map(it => it.id));\n\n  const normalizeRequires = (req) => {\n    if (req === null || req === undefined) return [];\n    if (Array.isArray(req)) return req.slice();\n    return [req];\n  };\n\n  // Precompute feasibility: an item is infeasible if any required id doesn't exist in the items list\n  const feasible = items.map(it => {\n    const reqs = normalizeRequires(it.requires);\n    return reqs.every(r => idSet.has(r));\n  });\n\n  const requiresArr = items.map(it => normalizeRequires(it.requires));\n\n  let best = null; // { value, spend, ids: sorted array }\n\n  const compareIdArraysLex = (a, b) => {\n    const len = Math.min(a.length, b.length);\n    for (let i = 0; i < len; i++) {\n      if (a[i] < b[i]) return -1;\n      if (a[i] > b[i]) return 1;\n    }\n    if (a.length < b.length) return -1;\n    if (a.length > b.length) return 1;\n    return 0;\n  };\n\n  const totalCombos = 1 << n;\n\n  for (let mask = 0; mask < totalCombos; mask++) {\n    let valid = true;\n    let totalSpend = 0;\n    let totalValue = 0;\n    const selectedIndices = [];\n    const groupCount = {};\n\n    for (let i = 0; i < n; i++) {\n      if (mask & (1 << i)) {\n        if (!feasible[i]) {\n          valid = false;\n          break;\n        }\n        selectedIndices.push(i);\n        totalSpend += items[i].spend;\n        totalValue += items[i].value;\n\n        const g = items[i].group;\n        if (g !== null && g !== undefined) {\n          groupCount[g] = (groupCount[g] || 0) + 1;\n          if (groupCount[g] > 1) {\n            valid = false;\n            break;\n          }\n        }\n      }\n    }\n\n    if (!valid) continue;\n    if (totalSpend > budget) continue;\n\n    // check requires\n    const selectedIdSet = new Set(selectedIndices.map(i => items[i].id));\n    for (const i of selectedIndices) {\n      const reqs = requiresArr[i];\n      for (const r of reqs) {\n        if (!selectedIdSet.has(r)) {\n          valid = false;\n          break;\n        }\n      }\n      if (!valid) break;\n    }\n\n    if (!valid) continue;\n\n    const ids = selectedIndices.map(i => items[i].id).slice().sort((a, b) => {\n      if (a < b) return -1;\n      if (a > b) return 1;\n      return 0;\n    });\n\n    if (best === null) {\n      best = { value: totalValue, spend: totalSpend, ids };\n    } else {\n      if (totalValue > best.value) {\n        best = { value: totalValue, spend: totalSpend, ids };\n      } else if (totalValue === best.value) {\n        if (totalSpend < best.spend) {\n          best = { value: totalValue, spend: totalSpend, ids };\n        } else if (totalSpend === best.spend) {\n          if (compareIdArraysLex(ids, best.ids) < 0) {\n            best = { value: totalValue, spend: totalSpend, ids };\n          }\n        }\n      }\n    }\n  }\n\n  return best ? best.ids : [];\n}"
