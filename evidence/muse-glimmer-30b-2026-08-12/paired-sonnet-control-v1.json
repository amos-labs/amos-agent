\n      for (const r of reqs) {\n        if (!selectedIdSet.has(r)) {\n          valid = false;\n          break;\n        }\n      }\n      if (!valid) break;\n    }\n\n    if (!valid) continue;\n\n    const ids = selectedIndices.map(i => items[i].id).slice().sort((a, b) => {\n      if (a < b) return -1;\n      if (a > b) return 1;\n      return 0;\n    });\n\n    if (best === null) {\n      best = { value: totalValue, spend: totalSpend, ids };\n    } else {\n      if (totalValue > best.value) {\n        best = { value: totalValue, spend: totalSpend, ids };\n      } else if (totalValue === best.value) {\n        if (totalSpend < best.spend) {\n          best = { value: totalValue, spend: totalSpend, ids };\n        } else if (totalSpend === best.spend) {\n          if (compareIdArraysLex(ids, best.ids) < 0) {\n            best = { value: totalValue, spend: totalSpend, ids };\n          }\n        }\n      }\n    }\n  }\n\n  return best ? best.ids : [];\n}\n```",
