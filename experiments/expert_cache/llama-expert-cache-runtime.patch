+        ggml_metal_buffer_get_base(cache.ids));
+    const uint8_t * source = static_cast<const uint8_t *>(op->src[0]->data);
+    const int32_t * selected_ids =
+        static_cast<const int32_t *>(op->src[2]->data);
+    std::vector<int32_t> expert_to_slot(n_experts, -1);
+    int64_t unique_experts = 0;
+    const auto copy_started = std::chrono::steady_clock::now();
+
+    for (int64_t route = 0; route < route_count; ++route) {
+        const int32_t expert_id = selected_ids[route];
+        if (expert_id < 0 || expert_id >= n_experts) {
+            GGML_LOG_ERROR(
+                "%s: invalid routed expert id %d at route %lld (n_experts=%lld)\n",
+                __func__,
+                expert_id,
+                (long long) route,
+                (long long) n_experts);
+            return false;
+        }
+
+        int32_t slot = expert_to_slot[expert_id];
+        if (slot < 0) {
+            if (unique_experts >= slot_limit) {
+                GGML_LOG_ERROR(
+                    "%s: routed batch needs more than %lld expert slots\n",
+                    __func__,
+                    (long long) slot_limit);
+                return false;
+            }
+            slot = (int32_t) unique_experts++;
+            expert_to_slot[expert_id] = slot;
+            memcpy(
+                slots + (size_t) slot * bytes_per_expert,
+                source + (size_t) expert_id * bytes_per_expert,
+                bytes_per_expert);
+        }
+        compact_ids[route] = slot;
+    }
+
+    cache.active_slots = unique_experts;
+    cache.active_weight_bytes = bytes_per_expert * unique_experts;
+    cache.active_id_bytes = id_bytes;
+
+    if (getenv("GGML_METAL_EXPERT_CACHE_TRACE") != nullptr) {
+        const double elapsed_ms =
+            std::chrono::duration<double, std::milli>(
+                std::chrono::steady_clock::now() - copy_started).count();
+        GGML_LOG_INFO(
+            "ExpertCache stage tensor='%s' tokens=%lld routes=%lld unique=%lld "
+            "bytes=%zu elapsed_ms=%.3f\n",
+            op->src[0]->name,
+            (long long) n_tokens,
+            (long long) route_count,
+            (long long) unique_experts,
+            cache.active_weight_bytes,
+            elapsed_ms);
+    }
+
+    return true;
+}
