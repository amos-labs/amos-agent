+kernel void kernel_expert_cache_fill(
+        constant ggml_metal_kargs_expert_cache_fill & args,
+        device const uint4 * source,
+        device const int32_t * global_ids,
+        device uint4 * slots,
+        device int32_t * compact_ids,
+        uint gid [[thread_position_in_grid]]) {
+    const uint64_t words_per_expert = args.bytes_per_expert / sizeof(uint4);
+    const uint64_t total_words = words_per_expert * args.experts_used;
+
+    if (gid < total_words) {
+        const uint32_t slot = gid / words_per_expert;
+        const uint64_t word_in_expert = gid - slot * words_per_expert;
+        const uint64_t source_word_stride =
+            args.source_expert_stride / sizeof(uint4);
+        const uint32_t global_id = global_ids[slot];
+
+        slots[gid] = source[
+            (uint64_t) global_id * source_word_stride + word_in_expert
+        ];
+    }
+
+    if (gid < args.experts_used) {
+        compact_ids[gid] = (int32_t) gid;
+    }
+}
